<Style name="buildings">

	<!-- z13 greenhouse -->
	<Rule>
		&maxscale_zoom13;
		&minscale_zoom13;
		<Filter>[building] = 'greenhouse'</Filter>
		<LineSymbolizer stroke="#777777" stroke-width="0.3" stroke-opacity="0.5" />
		<PolygonSymbolizer fill="#333333" fill-opacity="0.5" />
	</Rule>

	<!-- z13 normal -->
	<Rule>
		&maxscale_zoom13;
		&minscale_zoom13;
		<Filter>[building] != 'greenhouse'</Filter>
		<LineSymbolizer stroke="#777777" stroke-width="0.3" />
		<PolygonSymbolizer fill="#777777" />
	</Rule>


	<!-- z14 greenhouse -->
	<Rule>
		&maxscale_zoom14;
		&minscale_zoom14;
		<Filter>[building] = 'greenhouse'</Filter>
		<LineSymbolizer stroke="black" stroke-width="0.1" stroke-opacity="0.5" />
		<PolygonSymbolizer fill="#333333" fill-opacity="0.5" />
	</Rule>

	<!-- z14 normal -->
	<Rule>
		&maxscale_zoom14;
		&minscale_zoom14;
		<Filter>[building] != 'greenhouse'</Filter>
		<LineSymbolizer stroke="black" stroke-width="0.1" />
		<PolygonSymbolizer fill="#555555" />
	</Rule>


	<!-- z15-16 greenhouse -->
	<Rule>
		&maxscale_zoom15;
		&minscale_zoom16;
		<Filter>[building] = 'greenhouse'</Filter>
		<LineSymbolizer stroke="black" stroke-width="1.5" stroke-opacity="0.5" />
		<PolygonSymbolizer fill="#333333" fill-opacity="0.5" />
	</Rule>

	<!-- z15-16 normal -->
	<Rule>
		&maxscale_zoom15;
		&minscale_zoom16;
		<Filter>[building] != 'greenhouse'</Filter>
		<LineSymbolizer stroke="black" stroke-width="1.5" />
		<PolygonSymbolizer fill="#555555" />
	</Rule>


	<!-- z17 greenhouse -->
	<Rule>
		&maxscale_zoom17;
		&minscale_zoom17;
		<Filter>[building] = 'greenhouse'</Filter>
		<LineSymbolizer stroke="black" stroke-width="1.5" stroke-opacity="0.5" />
		<PolygonSymbolizer fill="#333333" fill-opacity="0.5" />
	</Rule>

	<!-- z17 normal -->
	<Rule>
		&maxscale_zoom17;
		&minscale_zoom17;
		<Filter>[building] != 'greenhouse'</Filter>
		<PolygonPatternSymbolizer file="symbols-otm/building_z17.png"/>
		<LineSymbolizer stroke="black" stroke-width="0.7" />
	</Rule>

</Style>